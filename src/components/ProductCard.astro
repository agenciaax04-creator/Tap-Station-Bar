---
const {
  title,
  description,
  price,
  imageUrl,
} = Astro.props;
---
<article class="rounded-2xl bg-zinc-950/40 ring-1 ring-white/10 shadow-glow overflow-hidden">
  <div class="flex gap-3 p-3">
    <div class="h-20 w-20 shrink-0 rounded-xl bg-zinc-900 ring-1 ring-white/10 overflow-hidden">
      {imageUrl ? (
        <img src={imageUrl} alt={title} class="h-full w-full object-cover" loading="lazy" />
      ) : (
        <div class="h-full w-full grid place-items-center text-zinc-600 text-xs">Sin imagen</div>
      )}
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-sm font-bold leading-tight text-zinc-100 truncate">{title}</h3>
        <div class="shrink-0 text-sm font-black text-brand-amber">${price}</div>
      </div>
      <p class="mt-1 text-xs leading-snug text-zinc-400 line-clamp-2">{description}</p>
    </div>
  </div>
</article>
