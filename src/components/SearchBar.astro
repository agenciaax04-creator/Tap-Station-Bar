---
const { placeholder = 'Buscar…' } = Astro.props;
---
<div class="w-full">
  <div class="flex items-center gap-2 rounded-xl bg-zinc-900/70 ring-1 ring-white/10 px-3 py-2">
    <span class="text-zinc-400" aria-hidden="true">⌕</span>
    <input
      class="w-full bg-transparent text-sm text-zinc-100 placeholder:text-zinc-500 outline-none"
      type="search"
      placeholder={placeholder}
      autocomplete="off"
    />
  </div>
</div>
